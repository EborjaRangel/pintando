# PostgreSQL (local, Docker o Railway)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pintura?schema=public"

# NextAuth — en producción usa la URL de Vercel y un secreto largo aleatorio
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="cambia-este-secreto-por-uno-seguro"

# Mapbox (geocodificación; el mapa base usa OpenFreeMap)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN="pk.tu_token_publico_de_mapbox"
NEXT_PUBLIC_MAPBOX_TOKEN="pk.tu_token_publico_de_mapbox"
NEXT_PUBLIC_MAPBOX_STYLE="mapbox://styles/mapbox/light-v11"
# NEXT_PUBLIC_PREFER_MAPBOX_BASEMAP="true"

# Solo local. En Vercel las subidas van a Blob (BLOB_READ_WRITE_TOKEN).
UPLOAD_DIR="public/uploads"

# Vercel Blob (producción). Se crea en el dashboard de Vercel → Storage → Blob.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
